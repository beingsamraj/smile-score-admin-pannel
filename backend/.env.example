# Database Configuration
# Supported drivers: sqlite:///./smile_score.db or postgresql+psycopg2://user:password@localhost:5432/smile_score
DATABASE_URL=sqlite:///./smile_score.db

# Security & JWT
# IMPORTANT: Generate a secure secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-in-production-super-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Setup (auto-seeded if no admin exists)
FIRST_SUPERADMIN_EMAIL=test@smilescore.internal
FIRST_SUPERADMIN_USERNAME=test
FIRST_SUPERADMIN_PASSWORD=test123
FIRST_SUPERADMIN_NAME=Test Superadmin

# Server Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PROJECT_NAME="Smile Score Admin Panel Backend"
